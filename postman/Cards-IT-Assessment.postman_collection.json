            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?page=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cards"],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Zero-based page index; page size fixed at 10"
                }
              ]
            },
            "description": "GET with pagination — 10 records per page. Expect 200."
          },
          "response": []
        },
        {
          "name": "Enrich Card (3rd Party)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards/{{cardId}}/enrich?externalUserId={{externalUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cards", "{{cardId}}", "enrich"],
              "query": [
                {
                  "key": "externalUserId",
                  "value": "{{externalUserId}}"
                }
              ]
            },
            "description": "Nested call: Client → Your API → JSONPlaceholder `/users/{id}`. Expect 200."
          },
          "response": []

            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardholderName\": \"Aina Binti Ali Updated\",\n  \"status\": \"ACTIVE\",\n  \"creditLimit\": 15000.00,\n  \"currency\": \"MYR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards/{{cardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cards", "{{cardId}}"]
            },
            "description": "UPDATE — update existing card (`@Transactional`). Expect 200."
          },
          "response": []
